PORT=5000

# Clerk Authentication
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# MongoDB Database
MONGO_URL=mongodb://localhost:27017/dukan

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Aramex Shipping API Configuration
# ARAMEX_ENV can be "dev" (test sandbox) or "live" (production)
ARAMEX_ENV=dev
ARAMEX_USER_NAME=
ARAMEX_PASSWORD=
ARAMEX_ACCOUNT_NUMBER=
ARAMEX_ACCOUNT_PIN=
ARAMEX_ACCOUNT_ENTITY=RUH
ARAMEX_ACCOUNT_COUNTRY_CODE=SA

# Physical fulfillment address (not the product's cultural origin)
ARAMEX_ORIGIN_CITY=Riyadh
ARAMEX_ORIGIN_STATE=
ARAMEX_ORIGIN_POSTAL_CODE=
ARAMEX_ORIGIN_ADDRESS_LINE1=
